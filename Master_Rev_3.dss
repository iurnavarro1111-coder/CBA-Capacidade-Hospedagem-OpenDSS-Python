! ===================================================================
! SCRIPT MESTRE DE SIMULAÇÃO (BDGD -> OpenDSS) - Com Medidor e Monitores
! 
! Este script cria a fonte de alimentação principal (subestação),
! conecta-a a um transformador específico, carrega todos os elementos 
! da rede BT (transformadores, linhas, cargas, geradores), adiciona 
! medidores/monitores e executa uma simulação diária.
! ===================================================================

! Limpa qualquer simulação anterior
Clear

! 1. CRIAÇÃO DO CIRCUITO E FONTE DE ALIMENTAÇÃO (VSource)
! Define um novo circuito e configura a fonte padrão 'Source'
New Circuit.RedeBT_Filtrada_BDGD

Edit VSource.Source
~ BasekV=13.8     ! Tensão base de 13.8 kV (fase-fase)
~ pu=1.0           ! Tensão de 1.0 p.u. na fonte
~ Angle=0         ! Ângulo de 0 graus na fonte
~ MVAsc3=4.80     ! MVA de curto trifásico
~ MVAsc1=4.80     ! MVA de curto monofásico
~ X1R1=1.2
~ X0R0=1.2
!~ R1=0.006453                   ! R1 em Ohms
!~ X1=0.007744                   ! X1 em Ohms
!~ R0=0.006453                   ! R0 em Ohms (R0=R1 para Dyn)
!~ X0=0.007744                   ! X0 em Ohms (X0=X1 para Dyn)
!~ X1R1=1.2
!~ X0R0=1.2
!~ MVAsc3=200000    ! Alta potência de curto trifásico (fonte ideal)
!~ MVAsc1=210000    ! Alta potência de curto monofásico (fonte ideal)
!~ R1=0.374674 X1=0.536452 R0=0.0001 X0=0.0001 ! Impedâncias muito baixas


! 2. REDIRECIONAMENTO DOS FICHEIROS DE DEFINIÇÃO
! Carrega primeiro os ficheiros que definem tipos (LineCodes, LoadShapes)
Redirect BDGD_LineCodes.dss
Redirect BDGD_LoadShapes.dss

! 3. REDIRECIONAMENTO DOS FICHEIROS DE ELEMENTOS
! Carrega os transformadores, incluindo o que será conectado à fonte
Redirect BDGD_Transformers.dss 

! 4. LINHA DE LIGAÇÃO (Fonte -> Transformador Específico)
! Cria uma linha curta para ligar a fonte à barra primária do transformador
! (Substitua 'NomeDoLineCodeApropriado' se tiver um definido, ou use parâmetros R/X)
New Line.Linha_Alimentadora_Trafo
~ Bus1=SourceBus.1.2.3           ! Barra da fonte (padrão do OpenDSS)
~ Bus2=13743-9643854CF.1.2.3    ! Barra primária do transformador (conforme solicitado)
~ Phases=3                        ! Assumindo linha trifásica
~ R1=0.0001 X1=0.0001 R0=0.0001 X0=0.0001 Length=0.001 units=km ! Linha "ideal" de 1 metro

! 5. REDIRECIONAMENTO DOS RESTANTES ELEMENTOS DA REDE
! Carrega linhas de BT, ramais, cargas e geradores
Redirect BDGD_Lines_SSDBT.dss
Redirect BDGD_Lines_RAMLIG.dss
Redirect BDGD_Loads_UCBT.dss
!Redirect BDGD_Loads_PIP.dss
!Redirect BDGD_Generators.dss  ! Inclui o LoadShape do Gerador

! --- Redirecionamentos para Níveis de Penetração (NP) ---
!Redirect PVSystems_NP25.dss
!Redirect PVSystems_NP50.dss
!Redirect PVSystems_NP75.dss
!Redirect PVSystems_NP100.dss
!Redirect PVSystems_NP125.dss
!Redirect PVSystems_NP150.dss
!Redirect PVSystems_NP175.dss
!Redirect PVSystems_NP200.dss
!Redirect PVSystems_NP250.dss
!Redirect PVSystems_NP300.dss
!Redirect PVSystems_Gerados.dss


! --- Monitores ---
Redirect BDGD_Monitors_Trafos_e_Reatores.dss
Redirect BDGD_Monitors_Barras.dss

! 6. DEFINIÇÃO DAS TENSÕES DE BASE
Set Voltagebases=[13.8, 0.220] ! MT, BT (L-L)
CalcVoltageBases  ! Calcula Vbase para todas as barras

! 7. CONFIGURAÇÃO E EXECUÇÃO DA SIMULAÇÃO (MODO DIÁRIO)
Set Mode=Daily     ! Modo de simulação diário
Set stepsize=15m   ! Passo de 15 minutos
Set number=96      ! Número de passos (96 * 15 min = 24 horas)

!Set Number=1
!Set Stepsize=1
!Set Hour= 23.75


! Resolve o fluxo de potência diário
!Set Maxiter=100
!Solve

! ==================================================================
! EXPORTAR DADOS DOS MONITORES (CONFORME SOLICITADO)
! Exporta potência (apenas do TR) e tensões (apenas das barras)
! ==================================================================

! Exporta Monitor do Transformador
Export Monitors Potencia_TRMT_2559631

! --- Monitores de Barras (SSDBT e RAMLIG) ---

! Exporta Monitores para a Barra: 2559631-9643859
Export Monitors Tensao_2559631-9643859

